<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        This is the native Android (View-system) theme, applied at <application> level in
        AndroidManifest.xml. All real UI is painted by Compose (core/design/Theme.kt), but
        Android still uses THIS theme's colorAccent/colorControl* attributes to tint things
        Compose does not draw itself: the text selection handle and the floating copy/cut/
        paste toolbar. It was left over from the v1 (pre-Compose) app with an unrelated blue
        palette and, critically, never defined colorAccent/colorControlActivated at all — so
        Android fell back to the MaterialComponents library default (a generic teal/green),
        which is what showed up as a mismatched, low-contrast selection handle and toolbar.
        Colors below are aligned to the real v2 palette (core/design/Theme.kt LightColors).
    -->
    <style name="Theme.FitTrackPlus" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/v2_emerald_primary</item>
        <item name="colorPrimaryVariant">@color/v2_emerald_primary</item>
        <item name="colorOnPrimary">@color/blanco</item>

        <item name="colorSecondary">@color/v2_copper_secondary</item>
        <item name="colorOnSecondary">@color/blanco</item>

        <item name="android:background">@color/base</item>
        <item name="colorOnBackground">@color/negro</item>

        <item name="colorSurface">@color/blanco</item>
        <item name="colorOnSurface">@color/negro</item>

        <item name="android:colorBackground">@color/base</item>

        <item name="colorTopBar">@color/v2_emerald_primary</item>
        <item name="colorBottomBar">@color/negro</item>

        <!-- Governs the text selection handle and the copy/cut/paste toolbar tint. -->
        <item name="colorAccent">@color/v2_emerald_primary</item>
        <item name="colorControlActivated">@color/v2_emerald_primary</item>
        <item name="colorControlNormal">@color/v2_outline</item>
        <item name="android:textColorPrimary">@color/v2_on_surface</item>
        <item name="android:textColorPrimaryInverse">@color/v2_action_mode_text</item>
        <item name="android:textColorPrimaryInverseDisableOnly">@color/v2_action_mode_text</item>
        <item name="android:textColorPrimaryInverseNoDisable">@color/v2_action_mode_text</item>
        <item name="android:actionMenuTextColor">@color/v2_action_mode_text</item>
        <item name="android:colorBackgroundFloating">@color/v2_action_mode_background</item>
        <item name="android:textSelectHandle">@drawable/text_select_handle</item>
        <item name="android:textSelectHandleLeft">@drawable/text_select_handle_left</item>
        <item name="android:textSelectHandleRight">@drawable/text_select_handle_right</item>
    </style>
</resources>
